# SpineSight — GoDaddy (Apache) configuration
# Upload the contents of the dist/ folder to public_html/

# SPA routing: send non-file requests to index.html — MAIN DOMAIN ONLY.
# The HTTP_HOST condition keeps these rules away from subdomains
# (e.g. diagnostics.spinesight.health), whose app lives in a subfolder.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve index.html itself directly
  RewriteCond %{HTTP_HOST} ^(www\.)?spinesight\.health$ [NC]
  RewriteRule ^index\.html$ - [L]

  # Existing files and directories are served as-is
  RewriteCond %{HTTP_HOST} ^(www\.)?spinesight\.health$ [NC]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else on the main domain falls back to the SPA
  RewriteCond %{HTTP_HOST} ^(www\.)?spinesight\.health$ [NC]
  RewriteRule ^ /index.html [L]
</IfModule>

# Long-term caching for hashed assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Correct MIME types
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
